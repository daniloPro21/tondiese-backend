# Copier en .env puis ajuster si besoin : cp .env.example .env
# Ces valeurs correspondent au setup local standard (docker-compose.yml + infra/docker-compose.yml).
# Spring Boot ne charge pas .env tout seul : set -a && source .env && set +a && mvn spring-boot:run

TONDISE_PROFILE=dev
SERVER_PORT=8081

# --- Base de données (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tondise_test
DB_USERNAME=postgres_user
DB_PASSWORD=postgres_password

# --- Cache / sessions (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentification (Keycloak) ---
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/tondise
KEYCLOAK_REALM=tondise
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=tondise-backend
KEYCLOAK_CLIENT_SECRET=changeme-dev-secret
KEYCLOAK_PUBLIC_CLIENT_ID=tondise-web

# --- Stockage fichiers (MinIO / S3) ---
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=tondise
MINIO_SECRET_KEY=tondise123
MINIO_BUCKET=tondise
MINIO_FOLDER=products

# --- Paiement (Stripe) — vides en dev, aucun paiement réel n'est déclenché ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Prod uniquement (non utilisé par le profil dev, gardé pour référence) ---
# CORS_ALLOWED_ORIGINS=https://votre-front.example.com
